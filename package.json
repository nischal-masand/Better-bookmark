{
  "name": "better-bookmark",
  "version": "1.1.0",
  "description": "A local, private bookmark manager that mirrors your Chrome bookmarks.",
  "license": "MIT",
  "author": "Nischal Masand",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nischal-masand/Better-bookmark.git"
  },
  "bugs": {
    "url": "https://github.com/nischal-masand/Better-bookmark/issues"
  },
  "homepage": "https://github.com/nischal-masand/Better-bookmark#readme",
  "keywords": [
    "bookmarks",
    "chrome",
    "self-hosted",
    "local-first",
    "sqlite",
    "bookmark-manager"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "better-bookmark": "bin/better-bookmark.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "web/dist/",
    "extension/"
  ],
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "cross-env BB_API_ONLY=1 tsx watch server/src/index.ts",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "start": "tsx server/src/index.ts",
    "start:bundle": "node bin/better-bookmark.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "test": "tsx server/test/sync.test.ts && tsx server/test/watch.test.ts && tsx server/test/ops.test.ts && tsx server/test/writer.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run smoke",
    "autostart:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-autostart.ps1",
    "autostart:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/uninstall-autostart.ps1"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@fastify/static": "^10.1.4",
    "@mozilla/readability": "^0.6.0",
    "@tailwindcss/vite": "^4.0.9",
    "@tanstack/react-query": "^5.66.9",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "chokidar": "^4.0.3",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "esbuild": "^0.25.0",
    "fastify": "^5.2.1",
    "linkedom": "^0.18.9",
    "lucide-react": "^0.475.0",
    "p-limit": "^6.2.0",
    "prettier": "^3.9.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "zod": "^3.24.2"
  }
}
