{
  "manifest_version": 3,
  "name": "Better Bookmark Sync",
  "version": "1.0.0",
  "description": "Lets your local Better Bookmark library delete and move bookmarks in Chrome.",
  "permissions": ["bookmarks", "alarms"],
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Better Bookmark Sync", "default_popup": "popup.html" }
}
