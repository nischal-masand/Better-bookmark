{
  "manifest_version": 3,
  "name": "Better Bookmark",
  "version": "1.1.0",
  "description": "Opens your Better Bookmark library, and keeps deletes and moves made there in sync with Chrome.",
  "permissions": ["bookmarks", "alarms"],
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Open Better Bookmark",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  }
}
